      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test('Ponto reativado nos resultados', () => pm.expect(pm.response.json().content[0]).to.include({id: pm.variables.get('pontoId'), ativo: true}));"
            ]
          }
        }
      ]
    },
